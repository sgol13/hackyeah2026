{
  "module": {
    "name": "entry",
    "type": "entry",
    "mainElement": "EntryAbility",
    "deviceTypes": ["default"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      { "name": "ohos.permission.READ_CALENDAR", "reason": "$string:calendar_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      { "name": "ohos.permission.WRITE_CALENDAR", "reason": "$string:calendar_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } }
    ],
    "abilities": [{
      "name": "EntryAbility",
      "srcEntry": "./ets/entryability/EntryAbility.ets",
      "icon": "$media:calendar_icon",
      "label": "$string:app_name",
      "startWindowIcon": "$media:calendar_icon",
      "startWindowBackground": "$color:start_background",
      "exported": true,
      "skills": [{ "entities": ["entity.system.home"], "actions": ["ohos.want.action.home"] }]
    }]
  }
}
